# LLM Provider — "groq" (recommended, free) or "gemini"
LLM_PROVIDER=groq

# Groq API key — free at console.groq.com (30 RPM, 14,400 req/day)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini API key (only needed if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Vector DB (auto-set by docker-compose)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=video_chunks

# Database
DATABASE_URL=sqlite+aiosqlite:///./hookiq.db

# CORS — set to your Vercel URL in production
FRONTEND_URL=*

# Whisper
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
